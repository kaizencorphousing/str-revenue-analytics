{
  "permissions": {
    "allow": [
      "Bash(py *)",
      "Bash(python *)",
      "Bash(pip install *)",
      "Bash(pytest *)",
      "Bash(streamlit run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "WebFetch(domain:developer.hospitable.com)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh repo create *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Edit(./.env)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(git add .env*)",
      "Bash(git add -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "python \"$(git rev-parse --show-toplevel)/.claude/hooks/pii_guard.py\""
          }
        ]
      }
    ]
  }
}
